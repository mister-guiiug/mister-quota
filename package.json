{
  "name": "mister-quota",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app to track AI service consumption with manual & automatic collection, ideal-pace tracking and skills-based connectors",
  "author": "mister-guiiug",
  "license": "MIT",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "tsc -p electron/tsconfig.json && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -p electron/tsconfig.json && vite build && pwa-bundle-budget",
    "build:electron": "npm run build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,mts,mjs,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,mjs,css,md,json}\"",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "e2e": "playwright test"
  },
  "bundleBudget": {
    "totalGzipKb": 98
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mister-guiiug/dev-pwa-config": "^6.3.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.misterguiiug.misterquota",
    "productName": "Mister Quota",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
