{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Electron: Main",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron${env:PATHEXT}",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "runtimeArgs": [".", "--remote-debugging-port=9223"],
      "env": {
        "VITE_DEV_SERVER_URL": "http://localhost:5173",
        "ELECTRON_ENABLE_LOGGING": "1"
      },
      "console": "integratedTerminal",
      "outFiles": ["${workspaceFolder}/dist-electron/**/*.js"],
      "sourceMaps": true,
      "preLaunchTask": "dev: electron prereqs"
    },
    {
      "name": "Electron: Renderer (attach)",
      "type": "chrome",
      "request": "attach",
      "port": 9223,
      "webRoot": "${workspaceFolder}/src",
      "timeout": 30000,
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${workspaceFolder}/src/*",
        "webpack:///*": "*"
      }
    },
    {
      "name": "Vitest: current file",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test", "--", "--run", "${relativeFile}"],
      "console": "integratedTerminal",
      "windows": { "runtimeExecutable": "npm.cmd" }
    },
    {
      "name": "Vitest: all",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test"],
      "console": "integratedTerminal",
      "windows": { "runtimeExecutable": "npm.cmd" }
    }
  ],
  "compounds": [
    {
      "name": "Electron: Main + Renderer",
      "configurations": ["Electron: Main", "Electron: Renderer (attach)"],
      "stopAll": true,
      "presentation": { "order": 1, "group": "1_electron" }
    }
  ]
}
